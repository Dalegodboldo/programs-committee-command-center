# Copy these from Supabase: the green Connect button > Framework > Next.js > .env.local
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Older projects show an anon key instead; this name also works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Access-request emails (server-only; optional)
RESEND_API_KEY=
ADMIN_NOTIFY_EMAILS=
# NOTIFY_FROM=AITCF Programs Committee <notify@alwaysintheclub.org>

# Ask Claude (server-only; optional)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ASSISTANT_DAILY_LIMIT=60
